# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

NODE_ENV=development
PORT=3000

# PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://aows_app:CAMBIA_ESTA_CONTRASENA@localhost:5432/aows
DATABASE_SSL=false

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Cuenta administrativa inicial (solo se usa si todavía no existe ninguna)
ADMIN_EMAIL=correo-del-administrador@ejemplo.com
ADMIN_PASSWORD=
ADMIN_NAME=Jorge Armando Ovalle

# Orígenes permitidos para el frontend, separados por coma (en producción, solo el dominio real)
CORS_ORIGINS=http://localhost:4200
PUBLIC_SITE_URL=http://localhost:4200
APP_TIMEZONE=America/Mexico_City

# Cloudinary (obligatorio en producción; en desarrollo, sin esto las imágenes se guardan en backend/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aows

# Correo saliente para la confirmación de eventos (opcional; sin esto el panel no envía correos).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=tu-cuenta@gmail.com y como SMTP_PASS una
# "contraseña de aplicación" (Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remitente visible (opcional). Ej.: Armando Ovalle Wedding Studio <tu-cuenta@gmail.com>
MAIL_FROM=
