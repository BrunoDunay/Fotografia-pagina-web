# Copia este archivo como .env y completa los valores. Nunca subas .env al repositorio.

NODE_ENV=development
PORT=3000

# PostgreSQL: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL=postgres://aows_app:CAMBIA_ESTA_CONTRASENA@localhost:5432/aows
DATABASE_SSL=false

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Cuenta administrativa inicial (solo se usa si todavía no existe ninguna)
ADMIN_EMAIL=Ovalle.photo00@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=Jorge Armando Ovalle

# Orígenes permitidos para el frontend, separados por coma
CORS_ORIGINS=http://localhost:4200
PUBLIC_SITE_URL=http://localhost:4200
APP_TIMEZONE=America/Mexico_City

# Cloudinary (opcional en desarrollo; sin esto la subida de imágenes queda deshabilitada)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=aows
